
# time inputs

transient	1m	0.1m


# input devices
input	soln1	pressurePump	pressure=100k
input	soln2	pressurePump	pressure=100k
input	soln3	pressurePump	pressure=100k
input	soln4	pressurePump	pressure=100k
input	soln5	pressurePump	pressure=100k
input	soln6	pressurePump	pressure=100k
input	soln7	pressurePump	pressure=100k
input   soln8   pressurePump    pressure=100k
input   soln9   pressurePump    pressure=100k
input   soln10   pressurePump    pressure=100k
input   soln11   pressurePump    pressure=100k
input   soln12   pressurePump    pressure=100k
input   soln13   pressurePump    pressure=100k

# chemical definitions
chem	sample	soln1	1
chem	R1	soln2	1
chem	R2	soln3	1
chem	R3	soln4	1
chem	R4	soln5	1
chem	R5	soln6	1
chem	R6	soln7	1
chem    R7  soln8   1
chem    R8  soln9   1
chem    R9  soln10  1
chem    R10 soln11  1
chem    R11 soln12  1
chem    R12 soln13  1

# eval chem time concentration node
# albumin1
eval	sample	0	out1	13.15789m
eval	R1	0	out1	21.92982m
eval	R2	0	out1	471.49123m
eval	R3	0	out1	493.42105m
# albumin2
eval	sample	0	out2	13.15789m
eval	R4	0	out2	21.92982m
eval	R5	0	out2	471.49123m
eval	R6	0	out2	493.42105m
# albumin3
eval	sample	0	out3	13.15789m
eval	R7	0	out3	21.92982m
eval	R8	0	out3	471.49123m
eval	R9	0	out3	493.42105m
# albumin4
eval	sample	0	out4	13.15789m
eval	R10	0	out4	21.92982m
eval	R11	0	out4	471.49123m
eval	R12	0	out4	493.42105m

    