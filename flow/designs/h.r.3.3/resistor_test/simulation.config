
# time inputs

transient	1m	0.1m


# input devices 
input	soln1	pressurePump	pressure=100k
input	soln2	pressurePump	pressure=100k
input	soln3	pressurePump	pressure=100k


# chemical definitions
chem	sample	soln1	1
chem	R1	soln2	1
chem	R2	soln3	1


# eval chem time concentration node
eval	sample	0	out1	9.009009m
eval	R1	0	out1	90.090090m
eval	R2	0	out1	900.90090m

    