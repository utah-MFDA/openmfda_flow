
# time inputs

transient	1m	0.1m


# input devices
input	soln1	pressurePump	pressure=100k
input	soln2	pressurePump	pressure=100k
input	soln3	pressurePump	pressure=100k
input	soln4	pressurePump	pressure=100k
input	soln5	pressurePump	pressure=100k
input	soln6	pressurePump	pressure=100k
input	soln7	pressurePump	pressure=100k
input	soln8	pressurePump	pressure=100k
input	soln9	pressurePump	pressure=100k
input	soln10	pressurePump	pressure=100k
input	soln11	pressurePump	pressure=100k
input	soln12	pressurePump	pressure=100k
input	soln13	pressurePump	pressure=100k
input	soln14	pressurePump	pressure=100k
input	soln15	pressurePump	pressure=100k
input	soln16	pressurePump	pressure=100k
input	soln17	pressurePump	pressure=100k
input	soln18	pressurePump	pressure=100k

# chemical definitions
chem	sample	soln1	1
chem	R1	soln2	1
chem	R2	soln3	1
chem	R3	soln4	1
chem	R4	soln5	1
chem	R5	soln6	1
chem	R6	soln7	1
chem	R7	soln8	1
chem	R8	soln9	1
chem	R9	soln10	1
chem	R10	soln11	1
chem	R11	soln12	1



# eval chem time concentration node
# albumin
eval	sample	0	out	23.4375m
eval	R1	0	out	39.0625m
eval	R2	0	out	97.65625m
eval	R3	0	out	839.84375m
# caffeine
eval	sample	0	out2	9.17431m
eval	R4	0	out2	495.41284m
eval	R5	0	out2	495.41284m
# calcium
eval	sample	0	out3	7.93651m
eval	R6	0	out3	99.20635m
eval	R7	0	out3	892.85714m
# cocaine 
eval	sample	0	out4	46.39175m
eval	R8	0	out4	283.50515m
eval	R9	0	out4	670.10309m
# ethyl 
eval	sample	0	out5	13.15789m
eval	R10	0	out5	296.05263m
eval	R11	0	out5	690.78947m




    