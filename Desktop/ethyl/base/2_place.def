VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN ethyl ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2550000 1590000 ) ;
ROW ROW_0 CoreSite 0 0 N DO 85 BY 1 STEP 30000 0 ;
ROW ROW_1 CoreSite 0 420000 FS DO 85 BY 1 STEP 30000 0 ;
ROW ROW_2 CoreSite 0 840000 N DO 85 BY 1 STEP 30000 0 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met1 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met1 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met2 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met2 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met3 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met3 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met4 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met4 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met5 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met5 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met6 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met6 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met7 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met7 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met8 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met8 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met9 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met9 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met10 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met10 ;
COMPONENTS 5 ;
    - mix0 diffmix_25px_0 + PLACED ( 1290000 420000 ) S ;
    - mix1 diffmix_25px_0 + PLACED ( 1290000 840000 ) N ;
    - serp0 p_serpentine_1_360_30_46 + PLACED ( 30000 0 ) N ;
    - serp1 p_serpentine_0_60_30_10 + PLACED ( 1200000 420000 ) FS ;
    - serp2 p_serpentine_0_30_30_1 + PLACED ( 1380000 840000 ) FN ;
END COMPONENTS
PINS 4 ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1590000 750000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1050000 660000 ) N ;
    - soln2 + NET soln2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1140000 660000 ) N ;
    - soln3 + NET soln3 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1230000 660000 ) N ;
END PINS
NETS 8 ;
    - connect0 ( serp0 out_fluid ) ( mix0 a_fluid ) + USE SIGNAL ;
    - connect1 ( serp1 out_fluid ) ( mix0 b_fluid ) + USE SIGNAL ;
    - connect2 ( serp2 out_fluid ) ( mix1 a_fluid ) + USE SIGNAL ;
    - connect3 ( mix1 b_fluid ) ( mix0 out_fluid ) + USE SIGNAL ;
    - out ( PIN out ) ( mix1 out_fluid ) + USE SIGNAL ;
    - soln1 ( PIN soln1 ) ( serp0 in_fluid ) + USE SIGNAL ;
    - soln2 ( PIN soln2 ) ( serp1 in_fluid ) + USE SIGNAL ;
    - soln3 ( PIN soln3 ) ( serp2 in_fluid ) + USE SIGNAL ;
END NETS
END DESIGN
