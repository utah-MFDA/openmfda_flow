COMPONENTS 7 ;
    - mix0 diffmix_25px_0 + PLACED ( 1800000 420000 ) S ;
    - mix1 diffmix_25px_0 + PLACED ( 1350000 420000 ) FS ;
    - mix2 diffmix_25px_0 + PLACED ( 1800000 840000 ) N ;
    - serp0 p_serpentine_0_360_30_48 + PLACED ( 450000 0 ) N ;
    - serp1 p_serpentine_0_360_30_32 + PLACED ( 0 420000 ) S ;
    - serp2 p_serpentine_0_360_30_8 + PLACED ( 900000 840000 ) FN ;
    - serp3 p_serpentine_0_60_30_8 + PLACED ( 1350000 840000 ) N ;
