TRACKS Y 30000 DO 52 STEP 30000 LAYER met10 ;
GCELLGRID X 0 DO 5 STEP 450000 ;
GCELLGRID Y 0 DO 3 STEP 450000 ;
COMPONENTS 7 ;
    - mix0 diffmix_25px_0 + PLACED ( 1830000 840000 ) FN ;
    - mix1 diffmix_25px_0 + PLACED ( 1680000 840000 ) FN ;
    - mix2 diffmix_25px_0 + PLACED ( 1590000 840000 ) FN ;
    - serp0 p_serpentine_3_360_30_50 + PLACED ( 0 420000 ) FS ;
    - serp1 p_serpentine_2_360_30_38 + PLACED ( 0 0 ) N ;
    - serp2 p_serpentine_1_360_30_20 + PLACED ( 0 840000 ) N ;
    - serp3 p_serpentine_0_60_30_6 + PLACED ( 1290000 1380000 ) N ;
END COMPONENTS
PINS 5 ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1590000 750000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1050000 660000 ) N ;
    - soln2 + NET soln2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1140000 660000 ) N ;
    - soln3 + NET soln3 + DIRECTION INPUT + USE SIGNAL
      + PORT
