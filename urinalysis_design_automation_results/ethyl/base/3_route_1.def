VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN ethyl ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2550000 1590000 ) ;
ROW ROW_0 CoreSite 0 0 N DO 85 BY 1 STEP 30000 0 ;
ROW ROW_1 CoreSite 0 420000 FS DO 85 BY 1 STEP 30000 0 ;
ROW ROW_2 CoreSite 0 840000 N DO 85 BY 1 STEP 30000 0 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met1 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met1 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met2 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met2 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met3 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met3 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met4 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met4 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met5 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met5 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met6 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met6 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met7 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met7 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met8 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met8 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met9 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met9 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met10 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met10 ;
GCELLGRID X 0 DO 5 STEP 450000 ;
GCELLGRID Y 0 DO 3 STEP 450000 ;
COMPONENTS 5 ;
    - mix0 diffmix_25px_0 + PLACED ( 1290000 420000 ) S ;
    - mix1 diffmix_25px_0 + PLACED ( 1290000 840000 ) N ;
    - serp0 p_serpentine_1_360_30_46 + PLACED ( 30000 0 ) N ;
    - serp1 p_serpentine_0_60_30_10 + PLACED ( 1200000 420000 ) FS ;
    - serp2 p_serpentine_0_30_30_1 + PLACED ( 1380000 840000 ) FN ;
END COMPONENTS
PINS 4 ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1590000 750000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1050000 660000 ) N ;
    - soln2 + NET soln2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1140000 660000 ) N ;
    - soln3 + NET soln3 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1230000 660000 ) N ;
END PINS
NETS 8 ;
    - connect0 ( serp0 out_fluid ) ( mix0 a_fluid ) + USE SIGNAL
      + ROUTED met4 ( 1350000 420000 ) ( * 450000 0 )
      NEW met3 ( 60000 420000 ) ( 1350000 * )
      NEW met4 ( 60000 30275 ) ( * 420000 )
      NEW met3 ( 1350000 420000 ) M3M4_PR
      NEW met3 ( 60000 420000 ) M3M4_PR
      NEW met3 ( 60000 30275 ) M3M4_PR ;
    - connect1 ( serp1 out_fluid ) ( mix0 b_fluid ) + USE SIGNAL
      + ROUTED met5 ( 1350275 480000 ) ( 1530000 * )
      NEW met2 ( 1530000 450275 ) ( * 480000 )
      NEW met4 ( 1350275 480000 ) M4M5_PR
      NEW met2 ( 1530000 480000 ) M2M3_PR
      NEW met3 ( 1530000 480000 ) M3M4_PR
      NEW met4 ( 1530000 480000 ) M4M5_PR
      NEW met1 ( 1530000 450275 ) M1M2_PR ;
    - connect2 ( serp2 out_fluid ) ( mix1 a_fluid ) + USE SIGNAL
      + ROUTED met5 ( 1290000 900000 ) ( 1319725 * )
      NEW met3 ( 1290000 900000 ) ( 1410000 * )
      NEW met2 ( 1410000 870275 ) ( * 900000 )
      NEW met4 ( 1319725 900000 ) M4M5_PR
      NEW met3 ( 1290000 900000 ) M3M4_PR
      NEW met4 ( 1290000 900000 ) M4M5_PR
      NEW met2 ( 1410000 900000 ) M2M3_PR
      NEW met1 ( 1410000 870275 ) M1M2_PR ;
    - connect3 ( mix1 b_fluid ) ( mix0 out_fluid ) + USE SIGNAL
      + ROUTED met5 ( 1290000 450000 ) ( 1319725 * )
      NEW met4 ( 1290000 450000 ) ( * 870000 )
      NEW met5 ( 1290000 870000 ) ( 1319725 * )
      NEW met4 ( 1319725 450000 ) M4M5_PR
      NEW met4 ( 1290000 450000 ) M4M5_PR
      NEW met4 ( 1290000 870000 ) M4M5_PR
      NEW met4 ( 1319725 870000 ) M4M5_PR ;
    - out ( PIN out ) ( mix1 out_fluid ) + USE SIGNAL
      + ROUTED met8 ( 1590000 750000 0 ) ( * 900000 )
      NEW met5 ( 1350275 900000 ) ( 1590000 * )
      NEW met5 ( 1590000 900000 ) M5M6_PR
      NEW met6 ( 1590000 900000 ) M6M7_PR
      NEW met7 ( 1590000 900000 ) M7M8_PR
      NEW met4 ( 1350275 900000 ) M4M5_PR
      NEW met8 ( 1590000 750000 ) M8M9_PR ;
    - soln1 ( PIN soln1 ) ( serp0 in_fluid ) + USE SIGNAL
      + ROUTED met8 ( 1050000 450000 ) ( * 660000 0 )
      NEW met7 ( 900000 450000 ) ( 1050000 * )
      NEW met3 ( 30000 450000 ) ( 900000 * )
      NEW met2 ( 30000 30000 ) ( * 450000 )
      NEW met2 ( 30000 30000 ) ( 59725 * 0 )
      NEW met7 ( 1050000 450000 ) M7M8_PR
      NEW met3 ( 900000 450000 ) M3M4_PR
      NEW met4 ( 900000 450000 ) M4M5_PR
      NEW met5 ( 900000 450000 ) M5M6_PR
      NEW met6 ( 900000 450000 ) M6M7_PR
      NEW met2 ( 30000 450000 ) M2M3_PR
      NEW met8 ( 1050000 660000 ) M8M9_PR ;
    - soln2 ( PIN soln2 ) ( serp1 in_fluid ) + USE SIGNAL
      + ROUTED met8 ( 1140000 630000 ) ( * 660000 0 )
      NEW met7 ( 1140000 630000 ) ( 1230000 * )
      NEW met2 ( 1230000 510275 ) ( * 630000 )
      NEW met7 ( 1140000 630000 ) M7M8_PR
      NEW met2 ( 1230000 630000 ) M2M3_PR
      NEW met3 ( 1230000 630000 ) M3M4_PR
      NEW met4 ( 1230000 630000 ) M4M5_PR
      NEW met5 ( 1230000 630000 ) M5M6_PR
      NEW met6 ( 1230000 630000 ) M6M7_PR
      NEW met1 ( 1230000 510275 ) M1M2_PR
      NEW met8 ( 1140000 660000 ) M8M9_PR ;
    - soln3 ( PIN soln3 ) ( serp2 in_fluid ) + USE SIGNAL
      + ROUTED met8 ( 1230000 660000 0 ) ( * 720000 )
      NEW met5 ( 1230000 720000 ) ( 1440000 * )
      NEW met2 ( 1440000 720000 ) ( * 869725 )
      NEW met5 ( 1230000 720000 ) M5M6_PR
      NEW met6 ( 1230000 720000 ) M6M7_PR
      NEW met7 ( 1230000 720000 ) M7M8_PR
      NEW met2 ( 1440000 720000 ) M2M3_PR
      NEW met3 ( 1440000 720000 ) M3M4_PR
      NEW met4 ( 1440000 720000 ) M4M5_PR
      NEW met1 ( 1440000 869725 ) M1M2_PR
      NEW met8 ( 1230000 660000 ) M8M9_PR ;
END NETS
END DESIGN
