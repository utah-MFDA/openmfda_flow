TRACKS Y 30000 DO 52 STEP 30000 LAYER met10 ;
GCELLGRID X 0 DO 5 STEP 450000 ;
GCELLGRID Y 0 DO 3 STEP 450000 ;
COMPONENTS 7 ;
    - mix0 diffmix_25px_0 + PLACED ( 1920000 840000 ) FN ;
    - mix1 diffmix_25px_0 + PLACED ( 1500000 420000 ) FS ;
    - mix2 diffmix_25px_0 + PLACED ( 1830000 840000 ) N ;
    - serp0 p_serpentine_3_360_30_48 + PLACED ( 450000 0 ) N ;
    - serp1 p_serpentine_1_360_30_24 + PLACED ( 0 420000 ) FS ;
    - serp2 p_serpentine_0_120_30_12 + PLACED ( 1230000 840000 ) N ;
    - serp3 p_serpentine_0_60_30_10 + PLACED ( 1530000 1020000 ) N ;
END COMPONENTS
PINS 5 ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1590000 750000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1050000 660000 ) N ;
    - soln2 + NET soln2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -500 -500 ) ( 500 500 )
        + FIXED ( 1140000 660000 ) N ;
    - soln3 + NET soln3 + DIRECTION INPUT + USE SIGNAL
