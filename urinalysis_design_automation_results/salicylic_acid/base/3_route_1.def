VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN salicylic_acid ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2550000 1590000 ) ;
ROW ROW_0 CoreSite 0 0 N DO 85 BY 1 STEP 30000 0 ;
ROW ROW_1 CoreSite 0 420000 FS DO 85 BY 1 STEP 30000 0 ;
ROW ROW_2 CoreSite 0 840000 N DO 85 BY 1 STEP 30000 0 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met1 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met1 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met2 ;
TRACKS Y 30000 DO 52 STEP 30000 LAYER met2 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met3 ;
